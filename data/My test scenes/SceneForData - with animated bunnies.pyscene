green_fill_light_mat.roughness = 1.0
green_fill_light_mat.emissiveColor = float3(0.45, 1.00, 0.35)     # vivid lime green
green_fill_light_mat.emissiveFactor = 7

front_wall_light_mat = StandardMaterial('FrontWallLightMat')
