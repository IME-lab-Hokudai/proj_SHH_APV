        scaling=float3(1.1, 1.6, 1.1),
        translation=float3(2.8, 0.8, -2.6),
        rotationEulerDeg=float3(0.0, 18.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(cubeMesh, green_mat)
