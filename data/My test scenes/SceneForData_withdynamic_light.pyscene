# ------------------------------------------------------------
# Scattered-object room scene for adaptive probe grid evaluation, with a dragon right under the middle (green fill) ceiling light
# Pure diffuse materials only
# Room bounds: x,z in [-5,5], y in [0,4]
# Geometry is scattered across the room instead of split by side
# ------------------------------------------------------------

# -------------------------
# Materials
# -------------------------
room_mat = StandardMaterial('RoomMaterial')
room_mat.baseColor = float4(0.78, 0.78, 0.78, 1.0)
room_mat.roughness = 1.0

red_mat = StandardMaterial('RedMaterial')
red_mat.baseColor = float4(0.88, 0.22, 0.20, 1.0)
red_mat.roughness = 1.0

blue_mat = StandardMaterial('BlueMaterial')
blue_mat.baseColor = float4(0.20, 0.35, 0.90, 1.0)
blue_mat.roughness = 1.0

green_mat = StandardMaterial('GreenMaterial')
green_mat.baseColor = float4(0.20, 0.78, 0.30, 1.0)
green_mat.roughness = 1.0

yellow_mat = StandardMaterial('YellowMaterial')
yellow_mat.baseColor = float4(0.92, 0.78, 0.18, 1.0)
yellow_mat.roughness = 1.0

cyan_mat = StandardMaterial('CyanMaterial')
cyan_mat.baseColor = float4(0.12, 0.78, 0.84, 1.0)
cyan_mat.roughness = 1.0

orange_mat = StandardMaterial('OrangeMaterial')
orange_mat.baseColor = float4(0.96, 0.50, 0.12, 1.0)
orange_mat.roughness = 1.0

purple_mat = StandardMaterial('PurpleMaterial')
purple_mat.baseColor = float4(0.46, 0.24, 0.84, 1.0)
purple_mat.roughness = 1.0

magenta_mat = StandardMaterial('MagentaMaterial')
magenta_mat.baseColor = float4(0.86, 0.22, 0.72, 1.0)
magenta_mat.roughness = 1.0

gray_mat = StandardMaterial('GrayMaterial')
gray_mat.baseColor = float4(0.62, 0.62, 0.62, 1.0)
gray_mat.roughness = 1.0

# Emissive light materials
warm_ceiling_light_mat = StandardMaterial('WarmCeilingLightMat')
warm_ceiling_light_mat.baseColor = float4(0, 0, 0, 1)
warm_ceiling_light_mat.roughness = 1.0
warm_ceiling_light_mat.emissiveColor = float3(1.00, 0.62, 0.22)   # amber / orange
warm_ceiling_light_mat.emissiveFactor = 11

cool_ceiling_light_mat = StandardMaterial('CoolCeilingLightMat')
cool_ceiling_light_mat.baseColor = float4(0, 0, 0, 1)
cool_ceiling_light_mat.roughness = 1.0
cool_ceiling_light_mat.emissiveColor = float3(0.20, 0.72, 1.00)   # cyan-blue
cool_ceiling_light_mat.emissiveFactor = 9

green_fill_light_mat = StandardMaterial('GreenFillLightMat')
green_fill_light_mat.baseColor = float4(0, 0, 0, 1)
green_fill_light_mat.roughness = 1.0
green_fill_light_mat.emissiveColor = float3(0.45, 1.00, 0.35)     # vivid lime green
green_fill_light_mat.emissiveFactor = 7

front_wall_light_mat = StandardMaterial('FrontWallLightMat')
front_wall_light_mat.baseColor = float4(0, 0, 0, 1)
front_wall_light_mat.roughness = 1.0
front_wall_light_mat.emissiveColor = float3(0.95, 0.25, 0.80)     # magenta / pink
front_wall_light_mat.emissiveFactor = 8

back_wall_light_mat = StandardMaterial('BackWallLightMat')
back_wall_light_mat.baseColor = float4(0, 0, 0, 1)
back_wall_light_mat.roughness = 1.0
back_wall_light_mat.emissiveColor = float3(0.95, 0.95, 0.95)      # neutral white
back_wall_light_mat.emissiveFactor = 6

# -------------------------
# Meshes
# -------------------------
quadMesh = TriangleMesh.createQuad()
cubeMesh = TriangleMesh.createCube()

# -------------------------
# Room shell
# -------------------------
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Floor', Transform(
        scaling=float3(10.0, 1.0, 10.0),
        translation=float3(0.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Ceiling', Transform(
        scaling=float3(10.0, 1.0, 10.0),
        translation=float3(0.0, 4.0, 0.0),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('LeftWall', Transform(
        scaling=float3(4.0, 1.0, 10.0),
        translation=float3(-5.0, 2.0, 0.0),
        rotationEulerDeg=float3(0.0, 0.0, -90.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('RightWall', Transform(
        scaling=float3(4.0, 1.0, 10.0),
        translation=float3(5.0, 2.0, 0.0),
        rotationEulerDeg=float3(0.0, 0.0, 90.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BackWall', Transform(
        scaling=float3(10.0, 1.0, 4.0),
        translation=float3(0.0, 2.0, -5.0),
        rotationEulerDeg=float3(90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('FrontWall', Transform(
        scaling=float3(10.0, 1.0, 4.0),
        translation=float3(0.0, 2.0, 5.0),
        rotationEulerDeg=float3(-90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, room_mat)
)

# -------------------------
# Scattered geometry
