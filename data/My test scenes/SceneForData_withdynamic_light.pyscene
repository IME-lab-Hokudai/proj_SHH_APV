)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BackWallLight', Transform(
        scaling=float3(1.4, 1.0, 1.0),
        translation=float3(2.6, 2.3, -4.99),
        rotationEulerDeg=float3(90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, back_wall_light_mat)
)

# -------------------------
# Near-emitter render test: one dragon right under the middle ceiling light
# -------------------------
# For the offline view evaluation (PlacementComparison.cpp) and the demo: render and dump with THIS scene, build the
# grids and trace the view reference with SceneForData.pyscene (no dynamic object).
#
# GreenFillCeilingLight (the middle one): emissive quad 1.2 x 1.2 m centred at (0.0, 3.99, 0.4), facing down
# (emissiveFactor 7). Probe grid bounds: x, z -4.9..4.9, y 0.04..3.96, so a body can come no closer than 3 cm to the
# light inside the grid. The object's top is at y 3.95, 4 cm under the light, centred under it. ThinSlabE
# (x -0.58..-0.23, z -1.5..-0.1, up to y 3.0) is below and behind it, clear of it.
#
# Dynamic object: the Stanford dragon (longer than the bunny, so it fills more of a wide view with the light in it),
# centred under the middle ceiling light with its top 4 cm below it (y 3.95, the grid ends at 3.96); spans y 3.53-3.95,
# x -0.3 to 0.3, z 0.27 to 0.54 (inside the light's footprint x -0.6..0.6, z -0.2..1.0).
# dragon.obj spans x [-0.240, 0.207], y [-0.283, 0.422], z [-0.472, 0.528] (1.0 long along z). Rotated 90 deg about y,
# so its length runs along x, across the view of the camera below (which looks along z). Scale 0.6 ->
# 0.60 m long, 0.42 m tall, 0.27 m deep. The bounding-box centre is off the mesh origin by at most
# 0.03 * scale in x and z, which is ignored.
obj_mat = StandardMaterial('DynamicObjectMaterial')
obj_mat.baseColor = float4(0.70, 0.70, 0.70, 1.0)
obj_mat.roughness = 1.0
obj_mat.metallic = 0.0

obj_mesh = TriangleMesh.createFromFile('meshes/dragon.obj', smoothNormals=True)
obj_scale = 0.6
light_cx, light_cz = 0.0, 0.4   # GreenFillCeilingLight centre
obj_top_y = 3.95
obj_y = obj_top_y - 0.4220 * obj_scale   # mesh top (y max 0.422) at obj_top_y
obj_translation = float3(light_cx, obj_y, light_cz)

# The mesh needs TWO instances: a mesh with one instance is merged into the scene's static mesh group, which shifts the
# geometry instance IDs after it (Bistro's lightmap atlas mapping is keyed by instance ID and then fails: "invalid
# triangleID ... for instanceID ..."). With two instances it forms its own group. The second one is 3 m below the
# floor, never in view.
obj_mesh_id = sceneBuilder.addTriangleMesh(obj_mesh, obj_mat)
obj_nodes = [
    ('Dragon_UnderMiddleLight', obj_translation),
    ('Dragon_Hidden', float3(light_cx, -3.0, light_cz)),
]
for name, translation in obj_nodes:
    sceneBuilder.addMeshInstance(
        sceneBuilder.addNode(
            name,
            Transform(
                scaling=float3(obj_scale, obj_scale, obj_scale),
                translation=translation,
                rotationEulerDeg=float3(0.0, 90.0, 0.0)
            )
        ),
        obj_mesh_id
    )

# -------------------------
# Camera
# -------------------------
camera = Camera()
# 2 m in front of the object (+z), a little below it, looking up so the light's edge is in view. Adjust freely; the
# view dump saves the camera actually used.
camera.position = float3(light_cx, 3.25, light_cz + 2.0)
camera.target = float3(light_cx, 3.80, light_cz)
camera.farPlane = 10000.0
camera.nearPlane = 0.1
sceneBuilder.addCamera(camera)