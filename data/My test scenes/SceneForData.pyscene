#green tilted tall box near corner
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('TallBoxJ', Transform(
        scaling=float3(0.7, 2.2, 0.7),
        translation=float3(-4.2, 1.5, 2.8),
        rotationEulerDeg=float3(0.0, -18.0, 8.0)
    )),
    sceneBuilder.addTriangleMesh(cubeMesh, green_mat)
)

#sceneBuilder.addMeshInstance(
#    sceneBuilder.addNode('BridgeBlockK', Transform(
#        scaling=float3(1.8, 0.45, 0.8),
