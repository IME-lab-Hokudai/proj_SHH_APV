sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('ShortBoxL', Transform(
        scaling=float3(1.0, 0.9, 1.0),
        translation=float3(-0.8, 0.45, -3.3),
        rotationEulerDeg=float3(0.0, 40.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(cubeMesh, blue_mat)
)

# -------------------------
# Area lights
# -------------------------
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('WarmCeilingLight', Transform(
        scaling=float3(1.8, 1.0, 1.8),
        translation=float3(-2.8, 3.99, -1.8),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, warm_ceiling_light_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('CoolCeilingLight', Transform(
        scaling=float3(1.6, 1.0, 1.6),
        translation=float3(2.4, 3.99, 2.0),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, cool_ceiling_light_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('GreenFillCeilingLight', Transform(
        scaling=float3(1.2, 1.0, 1.2),
        translation=float3(0.0, 3.99, 0.4),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, green_fill_light_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('FrontWallLight', Transform(
        scaling=float3(1.4, 1.0, 1.0),
        translation=float3(-1.5, 2.1, 4.99),
        rotationEulerDeg=float3(-90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, front_wall_light_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BackWallLight', Transform(
        scaling=float3(1.4, 1.0, 1.0),
        translation=float3(2.6, 2.3, -4.99),
        rotationEulerDeg=float3(90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, back_wall_light_mat)
)

sphere_mat = StandardMaterial('DynamicSphereMaterial')
sphere_mat.baseColor = float4(0.78, 0.78, 0.78, 1.0)
sphere_mat.roughness = 1.0
sphere_mat.metallic = 0.0
sphereMesh = TriangleMesh.createSphere(1.0, 64, 64)


sphereNodeID = sceneBuilder.addNode(
    'DynamicSphere',
    Transform(
        translation=float3(-1.5, 1.5,  3.4),
        rotationEulerDeg=float3(0.0, 275.0, 0.0),
        scaling=float3(.6,.6, .6)
    )
)

sceneBuilder.addMeshInstance(
    sphereNodeID,
    sceneBuilder.addTriangleMesh(sphereMesh, sphere_mat)
)
# -------------------------
# Camera
# -------------------------
camera = Camera()
#camera.position = float3(-1.1356, 1.9824,-3.3712)
#camera.target = float3(-1.0902, 1.9196, -2.3742)
camera.position = float3(-2.8498, 2.6995,-4.6577)
camera.target = float3(-2.3211, 2.4819, -3.8373)
camera.farPlane = 10000.0
camera.nearPlane = 0.1
sceneBuilder.addCamera(camera)