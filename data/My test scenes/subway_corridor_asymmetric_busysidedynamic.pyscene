# -------------------------
# Busy side lights
# -------------------------
# Ceiling light kept entirely on busy side (x < 0)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BusyCeilingLight', Transform(
        scaling=float3(1.8, 1.0, 1.8),
        translation=float3(-3.1, 3.99, 0.0),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, ceiling_light_mat)
)

# Two side lights mounted on the z > 0 wall (front wall), separated along x.
# Both face toward -Z into the room.
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BusyFrontWallLightLeft', Transform(
        scaling=float3(1.2, 1.0, 1.2),
        translation=float3(-3.0, 2.1, 4.99),
        rotationEulerDeg=float3(-90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, left_wall_light_mat)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('BusyFrontWallLightRight', Transform(
        scaling=float3(1.2, 1.0, 1.2),
        translation=float3(-3, 2.1, -4.99),
        rotationEulerDeg=float3(90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, right_wall_light_mat)
)

# Plain side light
# -------------------------
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('PlainLight', Transform(
        scaling=float3(1.8, 1.0, 1.8),
        translation=float3(3.0, 3.99, 0.0),
        rotationEulerDeg=float3(180.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, plain_light_mat)
)
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('PlainFrontWallLightRight', Transform(
        scaling=float3(1.2, 1.0, 1.2),
        translation=float3(3.0, 2.1, -4.99),
        rotationEulerDeg=float3(90.0, 0.0, 0.0)
    )),
    sceneBuilder.addTriangleMesh(quadMesh, right_wall_light_mat)
	)

# --- DYNAMIC BUNNY ---
# --- DYNAMIC BUNNY ---
bunny_mat = StandardMaterial('BunnyMaterial')
bunny_mat.baseColor = float4(0.7, 0.7, 0.7, 1.0)
bunny_mat.roughness = 1.0
	
bunny_mesh = TriangleMesh.createFromFile('meshes/bunny_dense.obj', smoothNormals=True)

# Better scale (2.0 is quite big for your room)
bunny_scales = [
float3(0.6, 0.6, 0.6),
float3(0.6, 0.6, 0.6),
float3(0.4, 0.4, 0.4),
]
# Put on floor
bunny_y = 0.0

# ------------------------------------------------------------
# Busy side (x < 0): complex lighting / occlusion
# ------------------------------------------------------------
bunny_positions_busy = [
    float3(-2.5, 1.8, 2.5),
    float3(-2.5, 1.8, 0),
    float3(-3, 2.5,  -2.5)
]

# ------------------------------------------------------------
# Plain side (x > 0): smooth lighting region
# ------------------------------------------------------------
bunny_positions_plain = [
    float3( 1.8, bunny_y, -2.0),
    float3( 3.2, bunny_y,  0.5),
    float3( 2.5, bunny_y,  2.5),
]

# Combine
bunny_positions = bunny_positions_busy
#bunny_positions = bunny_positions_busy + bunny_positions_plain

# Spawn
for i, p in enumerate(bunny_positions):
    sceneBuilder.addMeshInstance(
        sceneBuilder.addNode(
            f'Bunny_{i}',
            Transform(
                scaling=bunny_scales[i],
                translation=p,
                rotationEulerDeg=float3(0, 90, 0)
            )
        ),
        sceneBuilder.addTriangleMesh(bunny_mesh, bunny_mat)
    )
	
# -------------------------
# Camera
# -------------------------
camera = Camera()
camera.position = float3(3.6336,1.7370, -0.2974)
camera.target = float3(2.6358, 1.5, -0.2476)
camera.up = float3(0.0, 1.6926, 0.0)
camera.farPlane = 10000.0
camera.nearPlane = 0.1
sceneBuilder.addCamera(camera)
