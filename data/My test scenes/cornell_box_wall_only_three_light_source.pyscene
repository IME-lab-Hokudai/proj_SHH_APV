#

# Create materials

# 1. STRESS TEST MATERIALS
# ---------------------------------------------------------
# Blue Hotspot: Extremely bright, pure Blue. 
# Used for the small floor light to create sharp gradients.
lightBlueSharp = StandardMaterial('LightBlueSharp')
lightBlueSharp.emissiveColor = float3(0, 0, 1)
#lightBlueSharp.baseColor = float4(0.0, 0.0, 0.0, 1.0)
lightBlueSharp.emissiveFactor = 40  # High intensity for small area

# Red Fill: Softer, pure Red.
# Used for the large ceiling light (low frequency).
lightRedSoft = StandardMaterial('LightRedSoft')
lightRedSoft.emissiveColor = float3(1, 0, 0)
#lightRedSoft.baseColor = float4(0.0, 0.0, 0.0, 1.0)
lightRedSoft.emissiveFactor = 8 

# Green Glance: Medium brightness, Green.
lightGreen = StandardMaterial('LightGreen')
lightGreen.emissiveColor = float3(0, 1, 0)
#lightGreen.baseColor = float4(0.0, 0.0, 0.0, 1.0)
lightGreen.emissiveFactor = 15
# ---------------------------------------------------------

# Standard Cornell Materials
floor = StandardMaterial('Floor')
floor.baseColor = float4(0.725, 0.71, 0.68, 1.0)
floor.roughness = 1.0

backWall = StandardMaterial('Back Wall')
backWall.baseColor = float4(0.725, 0.71, 0.68, 1.0)
backWall.roughness = 1.0

ceiling = StandardMaterial('Ceiling')
ceiling.baseColor = float4(0.725, 0.71, 0.68, 1.0)
ceiling.roughness = 1.0

leftWall = StandardMaterial('Left Wall')
leftWall.baseColor = float4(0.63, 0.065, 0.05, 1.0)
leftWall.roughness = 1.0

rightWall = StandardMaterial('Right Wall')
rightWall.baseColor = float4(0.14, 0.45, 0.091, 1.0)
rightWall.roughness = 1.0

# Create geometry
quadMesh = TriangleMesh.createQuad()

# ---------------------------------------------------------
# SCENE GEOMETRY (Standard Cornell Box)
# ---------------------------------------------------------

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Floor', Transform(scaling=float3(0.55, 1.0, 0.55))),
    sceneBuilder.addTriangleMesh(quadMesh, floor)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Ceiling', Transform(scaling=float3(0.55, 1.0, 0.55), translation=float3(0, 0.55, 0), rotationEulerDeg=float3(180, 0, 0))),
    sceneBuilder.addTriangleMesh(quadMesh, ceiling)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Back Wall', Transform(scaling=float3(0.55, 1.0, 0.55), translation=float3(0, 0.275, -0.275), rotationEulerDeg=float3(90, 0, 0))),
    sceneBuilder.addTriangleMesh(quadMesh, backWall)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Left Wall', Transform(scaling=float3(0.55, 1.0, 0.55), translation=float3(-0.275, 0.275, 0), rotationEulerDeg=float3(0, 0, -90))),
    sceneBuilder.addTriangleMesh(quadMesh, leftWall)
)

sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('Right Wall', Transform(scaling=float3(0.55, 1.0, 0.55), translation=float3(0.275, 0.275, 0), rotationEulerDeg=float3(0, 0, 90))),
    sceneBuilder.addTriangleMesh(quadMesh, rightWall)
)

# ---------------------------------------------------------
# STRESS TEST LIGHTING (Asymmetric)
# ---------------------------------------------------------

# 1. BLUE HOTSPOT (Floor, Back-Left Corner)
# Position: Near (-0.2, -0.2). Just above floor (y=0.001).
# Scale: Tiny (0.04) -> Creates sharp shadows/gradients.
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('LightBlueSharp', Transform(scaling=0.04, translation=float3(-0.2, 0.0001, -0.2), rotationEulerDeg=float3(0, 0, 0))),
    sceneBuilder.addTriangleMesh(quadMesh, lightBlueSharp)
)

# 2. RED FILL (Ceiling, Front-Right Corner)
# Position: Near (0.2, 0.2). Just below ceiling (y=0.549).
# Scale: Large (0.15) -> Creates smooth, broad lighting.
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('LightRedSoft', Transform(scaling=0.15, translation=float3(0.2, 0.5499, 0.2), rotationEulerDeg=float3(180, 0, 0))),
    sceneBuilder.addTriangleMesh(quadMesh, lightRedSoft)
)

# 3. GREEN GLANCE (Right Wall, Low-Center)
# Position: On Right Wall (x=0.274), Low height (y=0.1).
# Scale: Vertical Strip -> Creates directional side lighting.
sceneBuilder.addMeshInstance(
    sceneBuilder.addNode('LightGreen', Transform(scaling=float3(0.1, 1.0, 0.05), translation=float3(0.2749, 0.1, -0.1), rotationEulerDeg=float3(0, 0, 90))),
    sceneBuilder.addTriangleMesh(quadMesh, lightGreen)
)

# ---------------------------------------------------------
# CAMERA
# ---------------------------------------------------------
camera = Camera()
camera.position = float3(0, 0.28, 1.2)
camera.target = float3(0, 0.28, 0)
camera.up = float3(0, 1, 0)
camera.focalLength = 35.0
sceneBuilder.addCamera(camera)